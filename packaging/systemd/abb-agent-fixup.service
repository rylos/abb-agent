[Unit]
Description=Recreate btrfs subvolumes left out of the abb-agent backup (after a restore)
Documentation=https://github.com/rylos/abb-agent
DefaultDependencies=no
After=systemd-remount-fs.service
Before=local-fs-pre.target local-fs.target
Wants=local-fs-pre.target
ConditionPathExists=/var/lib/abb-agent/excluded.json

[Service]
Type=oneshot
# Stays active once done: without it every later pull of local-fs.target during boot starts it
# again, and the fifth or sixth start in a few seconds fails with start-limit-hit.
RemainAfterExit=yes
ExecStart=/usr/bin/abb-agent restore-fixup

[Install]
WantedBy=local-fs.target
